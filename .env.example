# =====================================================================
# PATHFORGE AI - Environment Configuration
# =====================================================================

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Optional: Supabase JWT Secret (found in Supabase Settings -> API -> JWT Settings)
# Used for local zero-latency JWT signature verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Claude AI Provider Configuration (Anthropic API)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Alternative OpenAI / Compatible Endpoint Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
